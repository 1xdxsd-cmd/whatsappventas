# Tu número personal, con código de país y sin "+" (México: 52 y los 10 dígitos, ej. 525512345678).
# Aquí te llegan los avisos de pedidos, comprobantes y pedidos de asesor.
# Si hay varios administradores, sepáralos con comas: 525512345678,525587654321
NUMERO_ADMIN=

# Número del bot (el que vas a vincular). Si lo pones, en vez del QR aparece un
# código de 8 caracteres para escribir en WhatsApp > Dispositivos vinculados >
# Vincular con el número de teléfono. Déjalo vacío para usar el QR.
# Escríbelo como 52 + 10 dígitos (ej. 526771319656). Si WhatsApp dice que el
# número no es correcto, prueba con el "1" de celular (5216771319656).
NUMERO_BOT=

# Opcional: el código de 8 caracteres que quieres escribir en el teléfono, por
# ejemplo STREAM26 (letras y números, sin 0, O, I ni U). Vacío = uno al azar.
CODIGO_VINCULACION=

# Nombre del negocio que aparece en el saludo y en los recordatorios.
NOMBRE_NEGOCIO=Streaming Thalia

# Símbolo de moneda que ve el cliente en los precios (los precios están en pesos mexicanos).
MONEDA=$

# Datos para la transferencia, tal como los verá el cliente. Usa \n para saltos de línea.
# Si los llenas, se usan estos y no los Métodos de pago de la página.
DATOS_TRANSFERENCIA="Banco: ...\nCuenta: ...\nTitular: ..."

# Opcional: varias personas a las que el cliente puede pagar. Con dos o más, el
# bot le pregunta "¿A quién le quieres hacer la transferencia?" y el pedido o
# recarga y su comprobante solo les llegan a los números de esa persona (puede
# tener uno o varios, separados por comas; también quedan como admins).
# Si las llenas, se usan en vez de DATOS_TRANSFERENCIA.
PAGO_1_NOMBRE=
PAGO_1_NUMEROS=
PAGO_1_DATOS=
PAGO_2_NOMBRE=
PAGO_2_NUMEROS=
PAGO_2_DATOS=

# Carpeta donde se guarda la sesión de WhatsApp.
CARPETA_SESION=auth

# Conexión con tu página (StreamRent). Si la dejas vacía, el bot usa el
# catálogo de src/catalogo/servicios.js y DATOS_TRANSFERENCIA.
# Con la página conectada, el bot toma de ahí servicios, precios y métodos de
# pago, guarda los pedidos en "Pedidos" y los reportes en "Cuentas caídas".
PAGINA_URL=http://localhost:8081
PAGINA_USUARIO=admin
PAGINA_CLAVE=

# Opcional: la dirección de la página que se les da a los clientes cuando piden
# su usuario o cambian su contraseña (ej. https://mipagina.com).
PAGINA_ENLACE=

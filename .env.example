# Tu número personal, con código de país y sin "+" (México: 52 y los 10 dígitos, ej. 525512345678).
# Aquí te llegan los avisos de pedidos, comprobantes y pedidos de asesor.
NUMERO_ADMIN=

# Símbolo de moneda que ve el cliente en los precios (los precios están en pesos mexicanos).
MONEDA=$

# Datos para la transferencia, tal como los verá el cliente. Usa \n para saltos de línea.
DATOS_TRANSFERENCIA="Banco: ...\nCuenta: ...\nTitular: ..."

# Carpeta donde se guarda la sesión de WhatsApp.
CARPETA_SESION=auth

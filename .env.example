# Tu número personal, con código de país y sin "+" (México: 52 y los 10 dígitos, ej. 525512345678).
# Aquí te llegan los avisos de pedidos, comprobantes y pedidos de asesor.
NUMERO_ADMIN=

# Número del bot (el que vas a vincular). Si lo pones, en vez del QR aparece un
# código de 8 caracteres para escribir en WhatsApp > Dispositivos vinculados >
# Vincular con el número de teléfono. Déjalo vacío para usar el QR.
# Escríbelo como 52 + 10 dígitos (ej. 526771319656); si pones el "1" de
# celular (521...), el bot lo quita solo.
NUMERO_BOT=

# Nombre del negocio que aparece en el saludo y en los recordatorios.
NOMBRE_NEGOCIO=Streaming Thalia

# Símbolo de moneda que ve el cliente en los precios (los precios están en pesos mexicanos).
MONEDA=$

# Datos para la transferencia, tal como los verá el cliente. Usa \n para saltos de línea.
DATOS_TRANSFERENCIA="Banco: ...\nCuenta: ...\nTitular: ..."

# Carpeta donde se guarda la sesión de WhatsApp.
CARPETA_SESION=auth

# Conexión con tu página (StreamRent). Si la dejas vacía, el bot usa el
# catálogo de src/catalogo/servicios.js y DATOS_TRANSFERENCIA.
# Con la página conectada, el bot toma de ahí servicios, precios y métodos de
# pago, guarda los pedidos en "Pedidos" y los reportes en "Cuentas caídas".
PAGINA_URL=http://localhost:8081
PAGINA_USUARIO=admin
PAGINA_CLAVE=
